{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": [
    "@typescript-eslint"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "env": {
    "browser": false,
    "node": true
  },
  "rules": {
    "@typescript-eslint/no-empty-object-type": ["error", { "allowInterfaces": "with-single-extends" }]
  },
  "ignorePatterns": ["**.spec.*"]
}